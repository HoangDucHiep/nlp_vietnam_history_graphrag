# Copy to .env and fill in. .env is gitignored.

# --- LLM (Google AI Studio, free tier is enough for this project) ---
# Get a key at https://aistudio.google.com/apikey
# When absent, the pipeline runs in MOCK mode (deterministic offline stubs).
GEMINI_API_KEY=
# Chat model: the free tier allows ~15 RPM on the flash-lite models.
GEMINI_MODEL=gemini-3.1-flash-lite
# Embedding model (shares a 1k req/day free-tier quota with the other
# embedding models).  When the quota is exhausted the pipeline falls back
# automatically to the local sentence-transformers model (384-dim).
GEMINI_EMBED_MODEL=gemini-embedding-2

# --- Docker services ---
NEO4J_PASSWORD=history2025
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
QDRANT_PORT=6333

# --- Kaggle (optional, for embedding / LoRA fine-tune notebooks) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
